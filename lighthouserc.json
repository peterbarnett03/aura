{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/guides.html",
        "http://localhost/palindromic-rheumatism.html",
        "http://localhost/palindromic-rheumatism-vs-rheumatoid-arthritis.html",
        "http://localhost/flare-diary.html",
        "http://localhost/rheumatology-appointment.html",
        "http://localhost/support.html",
        "http://localhost/privacy.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    }
  }
}
